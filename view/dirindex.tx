: include "part/header.tx"

<div class="container is-full">

  <div class="section">
    <h1 class="title is-3">
      Index of <: $path :>
    </h1>
    <!-- Main container -->
    <nav class="level">
      <!-- Left side -->
      <div class="level-left">
        <div class="level-item">
          <p class="subtitle is-6"><strong>
              <: $total :>
            </strong> files</p>
        </div>
        <div class="level-item">
          <div class="field has-addons is-small">
            <p class="control">
              <input class="input is-small" type="text" placeholder="" />
            </p>
            <p class="control">
              <button class="button is-success is-small">Search</button>
            </p>
          </div>
        </div>
      </div>

      <!-- Right side -->
      <div class="level-right buttons are-small are-inverted are-outline">
        <p class="level-item">
        <div class="dropdown ">
          <div class="dropdown-trigger">
            <button class="button" aria-haspopup="true" aria-controls="dropdown-menu">
              <span>Download</span>
              <span class="icon is-small">
                <i class="fas fa-angle-down" aria-hidden="true"></i>
              </span>
            </button>
          </div>
          <div class="dropdown-menu" id="dropdown-menu" role="menu">
            <div class="dropdown-content">
              <a href="#" class="dropdown-item">.tar.zst</a>
              <a class="dropdown-item">.tar.gz</a>
              <a href="#" class="dropdown-item">.zip</a>
            </div>
          </div>
        </div>
        </p>
        <p class="level-item"><a class="button ">Playlist</a></p>
        <p class="level-item"><a class="button ">Export</a></p>
      </div>
    </nav>
    <ul class="smart-grid content">
      <li class="grid is-col-min-4">
        <span class="has-text-weight-bold cell is-col-span-5">Filename<span class="icon is-small">
            <i class="fas fa-angle-up" aria-hidden="true"></i>
          </span></span>
        <span class="has-text-weight-bold cell is-col-span-1">Size</span>
        <span class="has-text-weight-bold cell is-col-span-1">Type</span>
        <span class="has-text-weight-bold cell has-text-right">Last Modified</span>
      </li>
      :for $file -> $file {
      <li class="grid is-col-min-4">
        <span class="cell is-col-span-5">
          <a href="<: $file.uri :>">
            <: $file.name :>
          </a>
        </span>
        <span class="cell is-col-span-1">
          <: $file.size :>
        </span>
        <span class="cell is-col-span-1">
          <: $file.type :>
        </span>
        <span class="cell has-text-right is-row-span-1">
          <: $file.mtime :>
        </span>

      </li>
      : }
    </ul>
  </div>
</div>

: include "part/footer.tx"