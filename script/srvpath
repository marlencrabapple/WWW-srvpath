method GetOptionsFromArray : common {
    Getopt::Long::GetOptionsFromArray(@_);
}

method configure : common ( $argv //= \@ARGV ) {
    my %cliopt = ( index => true, reset_config => false );

    const my %pos_dest => ( 0 => 'root', 1 => 'mount' );

    $class->GetOptionsFromArray(
        $argv, \%cliopt,
        'index|dirindex|autoindex!',

        # 'port:i',
        'ssl|tls|x509:s',    # = server, client, mutual (default: server)
        'certfile|cert-file|certificate|ssl-cert-file|ssl-certfile:s',
        'validpath|intermediates|trustchain:s@'
        , # intermediate(s) as separate files (we may produce more specialized bundles similar to cfssl)
        'certbundle|cert-bundle:s'
        ,    # leaf cert with intermediates/trust chain in a single file

        # 'intermediates|chain:s'
        'keyfile|key-file|key|ssl-key-file|ssl-keyfile:s',

        'listen:s@',
        'socket|sockfile|unix:s',
        'port|service:s',
        'server|app-server|psgi-server|s:s',

        # Auth Basic
        'user|username:s',
        'pwhash|password-hash|crypt:s',             # argon2 hash
        'login|login-credentials|credentials:s',    # user:pwhash

        'verbose+',
        'debug', 'help',
        'version',

  # TODO: decide if its better to normalize these differnet option forms here or
  # in the WWW::srpath `ADJUST :params` block(s):
  #
  # - srvpath::CLI sub
  #   - a sub routine reference should handle it if its all done here and the
  #     paradigm is normal/familiar
  #   - no segfaults/panics (developer included)
  #
  # - WWW::srvpath
  #   - the :params attribute for ADJUST seems a perfect fit for transforming #
  #     values into what your class wants
  #   - a progmatic interface is planned so this won't be the only place these
  #     options may need to be handled in different forms
  #
  # current winnner: WWW::cgit object construction `ADJUST :params``
        'reset-config|clear-config',
        'config|config-file|config-path:s@',
        'wrapcgi|exec',

        'path|srvpath|root|public|www:s',

        'mount|endpoint|urlbase|uribase:s',    # valid input:
            #- a single base uri path one or more local paths will be mounted in

        'middleware=s@',
        'run-config!',
        '<>' => sub ($barearg) {
            state $pos //= 0;

            if ( $barearg =~ /^--((un|re)set|clear)-.+/ ) {
                $cliopt{ ( $barearg =~ s/^--?//rg =~ s/-/_/rg ) } = true;
                return;
            }
            else {

                error
                  "Positional arguments for 'root' and and 'mount' have already"
                  . " been set. Ignoring '$barearg'."
                  if $pos > 1;

                $cliopt{ $pos_dest{$pos} } = $barearg;
                $pos++;
            }
        }
    );

    my $srvpath = WWW::srvpath->new(
        (
            map { my ($k) = ( $_ =~ s/-/_/rg ); ( $k => $cliopt{$_} ) }
              keys %cliopt
        ),
    );

    @$argv = grep { $_ && $_ ne '--' } @$argv;

    # Pass through some commands to Plack::Runner for now
    push @$argv, pairmap {
        my @out = ();

        if ( my ($type) = ( refstr($b) =~ /^(ARRAY|HASH)$/ ) ) {
            my ( $sig, $name ) = sigil( \$b );
            if ( $type eq 'ARRAY' ) {
                @out = ( map { ( "--$a" => $_ ) } @$b );
            }
            elsif ( $type eq 'HASH' ) {
                foreach my ( $k, $v ) (%$b) {
                    push @out, "--$a\-$k", $v;
                }
            }

        }
        else { @out = ( "--$a", $b ) }
        @out;
    }
    pairgrep { $b }
    $srvpath->config->%{
        qw'listen ssl server socket app eval host port daemonize include plackenv reload no-default-middleware watch loader access-log path'
    };

    # dmsg $srvpath;
    $srvpath;
}

package srvpath::Runner;

use utf8;
use v5.44;

use IO::Handle::Common;

my $srvpath = srvpath->configure( \@ARGV );
my $psgi    = $srvpath->to_psgi;

unless (caller) {
    require Plack::Runner;

    my $runner = Plack::Runner->new;

    # dmsg \@ARGV;
    $runner->parse_options(@ARGV);

    $runner->run($psgi);

    $psgi->runner($runner);

    error "$! ($?)" if $? > 0;
    exit $?;
}

return $psgi
