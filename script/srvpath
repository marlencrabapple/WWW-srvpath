#!/usr/bin/env perl
use Object::Pad ':experimental(:all)';

package srvpath;

class srvpath;    #: does(WWW::srvpath::CLI);

use utf8;
use v5.44;

use builtin;
use Path::Try;
use Getopt::Long qw(:config no_ignore_case bundling passthrough autoabbrev);
use Const::Fast;
use IO::Handle::Common;
use List::Util 'first';
use WWW::srvpath;
use WWW::srvpath::Base 'refstr';

